# ==========================================================
# Backend Environment Configuration (.env)
# ==========================================================
# Copy this file to .env and fill in all values before deploying.
# ==========================================================

# ── General ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.your-domain.xyz

# ── Database (MySQL inside Docker) ───────────────────────
# The hostname "db" refers to the MySQL container in docker-compose
DATABASE_URL="mysql://root:YOUR_STRONG_DB_PASSWORD@db:3306/final_project_db"

# ── Redis (inside Docker) ────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── NextAuth ─────────────────────────────────────────────
NEXTAUTH_URL=https://www.your-domain.xyz
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET

# ── JWT ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=YOUR_JWT_SECRET


# ── Firebase Admin (Push Notifications) ──────────────────
# Must be a SINGLE LINE of JSON! Convert with:
#   cat your-firebase-key.json | tr -d '\n' | tr -s ' '
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ── Resend (Email Service) ───────────────────────────────
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL="MediBuddy <noreply@your-domain.xyz>"

# ── Abstract API (Email Validation) ─────────────────────
ABSTRACT_EMAIL_API_KEY=YOUR_ABSTRACT_EMAIL_API_KEY

# ── Worker Configurations ────────────────────────────────
AUTH_CLEANUP_CRON="*/10 * * * *"
AUTH_UNVERIFIED_USER_GRACE_HOURS=24
AUTH_UNVERIFIED_USER_BATCH_SIZE=500
